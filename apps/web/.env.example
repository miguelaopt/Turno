# Copia este ficheiro para .env.local e preenche com os valores do teu projeto
# Supabase (Project Settings → API). Usa APENAS a anon/publishable key.
# NUNCA coloques aqui a service role key: tudo o que é NEXT_PUBLIC_ vai para o browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cola-aqui-a-anon-key
